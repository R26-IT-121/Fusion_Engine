# Copy this file to .env and fill in your values

# --- LLM Provider ---
# "gemini" (default) or "ollama"
LLM_PROVIDER=gemini

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Paths ---
CHROMA_DB_PATH=./chroma_store
FATF_DATA_PATH=./data/fatf_typologies.json
MODEL_SAVE_PATH=./models/meta_classifier.joblib

# --- Upstream Model API Base URLs ---
# These are BASE URLs — the adapters append the correct path per model:
#   M1 Wijesinghe  VAE/DSAA    → {BEHAVIORAL_API_BASE}/api/v1/behavioral/classify
#   M2 Ewaduge     GraphSAGE   → {GRAPH_API_BASE}/api/graph/analyze
#   M3 Pathirana   TCN/TSCFD   → {TEMPORAL_API_BASE}/api/v1/classify
#
# Replace with actual host:port when each member deploys their API.
# If an upstream API is unreachable, its score is imputed as 0.5 with a confidence penalty.
BEHAVIORAL_API_BASE=http://localhost:8001
GRAPH_API_BASE=http://localhost:8002
TEMPORAL_API_BASE=http://localhost:8003

# Timeout in milliseconds for upstream model calls (increase if models are slow to respond)
UPSTREAM_TIMEOUT_MS=5000

# --- Email Configuration ---
# SendGrid API key (no password needed - just secure API key)
# Get free account: https://sendgrid.com
# Get API key: https://sendgrid.com/account/general
SENDGRID_API_KEY=SG.xxxxx_your_sendgrid_api_key_xxxxx

SENDER_EMAIL=alerts@deepsentinel.io
SENDER_NAME=DeepSentinel Fraud Alerts

# Settings file for risk managers and alert configuration
SETTINGS_FILE=./settings.json
