# Configuration — never commit secrets.
# config.example.ini is the committed template; config.ini holds real keys.
config.ini
.env

# User database — contains password hashes, never commit
users.json

# Local SQLite database
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime configuration written by the app
settings.json

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/

# ChromaDB — rebuilt automatically from data/fatf_typologies.json on startup
chroma_store/
chroma_store_test/

# Trained model — auto-retrains from synthetic data on startup
models/

# pytest / test artifacts
.pytest_cache/
htmlcov/
.coverage

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Disposable test database
tests/_test.db

# Evaluation output � regenerate with scripts/evaluate_ablation.py
data/evaluation/
